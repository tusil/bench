# Unique hostname used in Tailscale MagicDNS.
TS_HOSTNAME=bench-dev

# Required only when connecting a new or logged-out server.
TS_AUTHKEY=

# Projects directory relative to the Bench user's home.
BENCH_PROJECTS_DIR=Projects

# Git repository prefix used by `bench init --template <name>`.
BENCH_TEMPLATE_REPOSITORY_PREFIX=git@github.com:tusil/bench-template-

# Wildcard domain used for Bench projects.
BENCH_DOMAIN=bench.example.dev

# DuckDNS domain used only for the delegated ACME DNS challenge.
DUCKDNS_DOMAIN=example-bench.duckdns.org

# DuckDNS account token used by Caddy to renew TLS certificates.
DUCKDNS_API_TOKEN=
